# Copy to .env for running the apps directly with Node (not needed for `docker compose up`).
# NEVER commit .env.

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (matches the postgres service in docker-compose.yml, published on localhost:5433)
DATABASE_URL=postgres://relayx:relayx@localhost:5433/relayx
DB_POOL_MAX=10

# API
PORT=3000
# Required to create tenants through POST /api/v1/tenants. Use a long random value (>= 16 chars).
ADMIN_TOKEN=local-admin-token-change-me
# Optional: protects GET /metrics with "Authorization: Bearer <token>"
# METRICS_TOKEN=
CORS_ORIGIN=http://localhost:5173
DEFAULT_RATE_LIMIT_PER_MINUTE=120

# SSRF protection. true = allow http:// and private/localhost webhook targets (LOCAL DEMO ONLY).
# MUST be false (the default) anywhere that is reachable from the internet.
ALLOW_PRIVATE_WEBHOOK_TARGETS=true

# Worker
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_METRICS_PORT=9101
LEASE_DURATION_MS=60000
DELIVERY_TIMEOUT_MS=5000
SHUTDOWN_GRACE_MS=15000

# Retry policy: delay = min(BASE * FACTOR^(attempt-1), MAX) +/- JITTER
MAX_ATTEMPTS=6
RETRY_BASE_DELAY_MS=5000
RETRY_FACTOR=3
RETRY_MAX_DELAY_MS=120000
RETRY_JITTER=0.25

# Receiver simulator
RECEIVER_SECRET=whsec_demo_local_secret
RECEIVER_HANG_MS=6000

# Integration tests (a separate database that the test setup creates for you)
TEST_DATABASE_URL=postgres://relayx:relayx@localhost:5433/relayx_test

# Seed script (local demo only)
SEED_API_KEY=rx_demo_local_key_0123456789abcdef
SEED_RECEIVER_URL=http://localhost:4000/webhook
SEED_ENDPOINT_SECRET=whsec_demo_local_secret
