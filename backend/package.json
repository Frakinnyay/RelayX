{
  "name": "relayx-backend",
  "version": "1.0.0",
  "private": true,
  "description": "RelayX - reliable webhook delivery (API, worker, receiver simulator)",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/main.ts",
    "dev:receiver": "tsx watch --env-file-if-exists=.env src/receiver/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:integration": "jest --runInBand --selectProjects integration",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker/main.js",
    "start:receiver": "node dist/receiver/main.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "pg": "^8.11.5",
    "prom-client": "^15.1.0",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
